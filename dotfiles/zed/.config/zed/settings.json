// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "colorize_brackets": true,
  "disable_ai": false,
  "ssh_connections": [
    {
      "host": "ubuntu-server",
      "args": [],
      "projects": [
        {
          "paths": ["/opt/stacks"],
        },
      ],
    },
    {
      "host": "main-ru",
      "args": [],
      "projects": [
        {
          "paths": ["/opt/stacks/"],
        },
      ],
    },
    {
      "host": "ubuntu-test",
      "args": [],
      "projects": [
        {
          "paths": ["/home/artem/Labs"],
        },
      ],
    },
  ],
  "ui_font_family": ".ZedMono",
  "terminal": {
    "toolbar": {
      "breadcrumbs": false,
    },
    "font_size": 14.0,
    "font_family": "FiraCode Nerd Font Mono",
  },
  "autosave": "on_focus_change",
  "vim_mode": false,
  "buffer_font_family": "JetBrains Mono NL",
  "icon_theme": "Material Icon Theme",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "ui_font_size": 16,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Kanagawa Wave",
  },
  "format_on_save": "on",
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
    },
    "YAML": {
      "tab_size": 2,
      "hard_tabs": false,
    },
  },
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--background-index",
          "--clang-tidy",
          "--completion-style=detailed",
          "--header-insertion=never",
          "--all-scopes-completion",
        ],
      },
    },
  },
}
